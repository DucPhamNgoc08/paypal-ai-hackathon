# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Every value is optional: anything left empty runs in mock mode.

# PayPal sandbox credentials
# Get them at https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Optional: ID of a sandbox webhook registered for /api/webhooks/paypal.
# Polling works without it; incoming webhooks are rejected until it is set.
PAYPAL_WEBHOOK_ID=

# AI provider (any OpenAI-compatible chat completions API)
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
# Set this to a model your provider actually offers.
AI_MODEL=gpt-4o-mini

# Demo partners' PayPal emails: sandbox personal accounts, comma separated, in partner order
# (Quang Ninh, Hai Phong, Thai Binh). Left empty, partners use @example.com addresses,
# and sandbox payouts to those end UNCLAIMED.
PARTNER_PAYPAL_EMAILS=
